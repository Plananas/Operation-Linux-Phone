# TREND OS kernel config fragment, applied on top of vivalto3mveml3g_hw00_defconfig.
# The public defconfig is for the board variant with a Spreadtrum "Marlin" Wi-Fi/BT chip;
# this phone (hw_revision=2) has the Broadcom BCM43430A1. Matched against the stock kernel's
# /proc/kallsyms (2026-11-03).
# Broadcom Wi-Fi (bcmdhd, built in as "dhd") + BT power/rfkill (also powers the FM core)
CONFIG_BCM4343=y
CONFIG_BCM_BT_RFKILL=y
CONFIG_BCM_BT_LPM=y
# no Spreadtrum Marlin Wi-Fi/BT
# CONFIG_SPRD_WCN is not set
# CONFIG_SDIODEV is not set
# Bluetooth for BlueZ (stock had none: Android drove the chip from userspace). The chip sits
# on the UART /dev/ttyS0 (H4); its firmware patch is loaded from userspace before attaching.
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_UHID=y
# Broadcom GPS (stock), not the LSI one
CONFIG_GPS_BCM47520=y
# CONFIG_GPS_LSI_S5N6420 is not set
# compressed swap as in stock
CONFIG_FRONTSWAP=y
CONFIG_ZPOOL=y
CONFIG_ZSWAP=y
CONFIG_VNSWAP=y
# Marlin firmware download/debug helpers (link against the Marlin SDIO driver)
# CONFIG_SPRD_DOWNLOAD_IMG is not set
# CONFIG_SPRD_DOWNLOAD_POWER_CTL is not set
# CONFIG_MDBG_SDIO is not set
# CONFIG_MDBG_RING is not set
# preallocated Wi-Fi buffers, as stock (DHD static buf)
CONFIG_BROADCOM_WIFI_RESERVED_MEM=y
# Spreadtrum Marlin BT low-power helper (needs the Marlin SDIO driver)
# CONFIG_SPRD_2331 is not set
