#!/bin/sh
# Route the sprdphone ALSA card (HiFi pcm 0) to wired headphones. The FM radio has its own path to
# them (tos/hw/fm.py). The card is addressed by name: its number changes between boots.
# Usage: audio-headphones [on|off]
c() { amixer -q -c sprdphone cset name="$1" "$2" 2>/dev/null || echo "audio-headphones: failed: $1=$2" >&2; }
if [ "$1" = off ]; then
	c 'HPL Mixer DACLHPL Switch' 0; c 'HPR Mixer DACRHPR Switch' 0
	c 'HeadPhone Function' 0
	exit 0
fi
c 'VBC Switch' ap
c 'DACL Playback Volume' 5;  c 'DACR Playback Volume' 5
c 'HPL Playback Volume' 8;   c 'HPR Playback Volume' 8
c 'HPL Mixer DACLHPL Switch' 1
c 'HPR Mixer DACRHPR Switch' 1
c 'HeadPhone Mute' 0
c 'HeadPhone Function' 1
